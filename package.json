{
  "name": "bridge-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "tune": "node --import tsx --import ./tools/tune/res-register.mjs tools/tune/tune.ts",
    "tune:unpack": "node --import tsx --import ./tools/tune/res-register.mjs tools/tune/unpack.ts",
    "tuner": "vite --open /tuner"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.15"
  }
}
