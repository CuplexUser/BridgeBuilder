{
  "name": "bridge-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Draw the truss. Send the truck. Pray.",
  "author": "Martin Dahl",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "smoke": "node --import tsx tools/smoke.ts",
    "tune": "node --import tsx --import ./tools/tune/res-register.mjs tools/tune/tune.ts",
    "verify": "node --import tsx --import ./tools/tune/res-register.mjs tools/verify/verify.ts",
    "tune:unpack": "node --import tsx --import ./tools/tune/res-register.mjs tools/tune/unpack.ts",
    "tuner": "vite --open /tuner",
    "android": "npm run build && cap sync android",
    "android:run": "npm run android && cap run android",
    "android:open": "cap open android",
    "games-ids": "node --import tsx --import ./tools/tune/res-register.mjs tools/games-ids.ts",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:dist": "npm run build && electron-builder --config desktop/builder.json"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  }
}
