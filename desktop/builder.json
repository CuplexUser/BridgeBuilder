{
  "appId": "se.cuplex.bridgebuilder",
  "productName": "Bridge Builder",
  "copyright": "Copyright © 2026 Martin Dahl",
  "directories": { "output": "release", "buildResources": "desktop" },
  "files": ["dist/**/*", "desktop/main.mjs", "desktop/preload.cjs", "desktop/icon.png", "package.json", "!node_modules/**/*"],
  "asar": true,
  "win": {
    "icon": "desktop/icon.png",
    "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
  },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Bridge-Builder-Setup-${version}.${ext}" },
  "portable": { "artifactName": "Bridge-Builder-${version}-portable.${ext}" },
  "linux": { "icon": "desktop/icon.png", "target": ["AppImage"], "category": "Game" },
  "mac": { "icon": "desktop/icon.png", "target": ["dmg"], "category": "public.app-category.puzzle-games" }
}
